{
  "type": "GoogleCloud",
  "projectId": "alfathpulsa",
  "storageBucket": "alfathpulsa.appspot.com",
  "apiVersion": "v1",
  "appId": "7390f3bf-0f50-4c77-82b1-2d163cbdf5c6",
  "deploymentTarget": "vercel",
  "gitIntegration": {
    "enabled": true,
    "autoSync": true,
    "syncBranch": "main",
    "deploymentBranch": "main"
  },
  "buildConfig": {
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "nodeVersion": "18",
    "installCommand": "npm install"
  },
  "environment": {
    "development": {
      "apiUrl": "http://localhost:3000"
    },
    "production": {
      "apiUrl": "https://alfathprinter.vercel.app"
    }
  },
  "features": {
    "webShareTarget": true,
    "pwa": true,
    "bluetooth": true,
    "serviceWorker": true
  }
}
